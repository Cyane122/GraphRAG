{
  "description": "GraphRAG repository context and safety guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.ai/hooks/context_loader.py\"",
            "commandWindows": "python .ai/hooks/context_loader.py",
            "timeout": 30,
            "statusMessage": "Loading active repository context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.ai/hooks/context_loader.py\"",
            "commandWindows": "python .ai/hooks/context_loader.py",
            "timeout": 30,
            "statusMessage": "Loading subagent context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.ai/hooks/guard_commands.py\"",
            "commandWindows": "python .ai/hooks/guard_commands.py",
            "timeout": 30,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.ai/hooks/validate_changelog.py\"",
            "commandWindows": "python .ai/hooks/validate_changelog.py",
            "timeout": 30,
            "statusMessage": "Checking changelog policy"
          }
        ]
      }
    ]
  }
}
