ANTHROPIC_API_KEY=sk-ant-api03-*
MODEL_ACTOR=claude-sonnet-4-6
WIKI_VAULT_ROOT=wiki_v2
MODEL_COMPLEX_UPDATER=claude-sonnet-4-6
MODEL_STATE_UPDATER=claude-haiku-4-5-20251001
MODEL_CLASSIFIER=claude-haiku-4-5-20251001

# Wiki recall budgets. Trimming starts when either the document or estimated token budget is exceeded.
WIKI_ACTOR_RECALL_BUDGET=24
WIKI_UPDATER_RECALL_BUDGET=48
WIKI_ACTOR_RECALL_TOKEN_BUDGET=12000
WIKI_UPDATER_RECALL_TOKEN_BUDGET=32000

# Optional Wiki parity postprocessors. All are off unless explicitly enabled.
WIKI_MEMORY_DISTORTION=false
WIKI_GOSSIP=false
WIKI_PERSONALITY_DRIFT=false
WIKI_PREGNANCY=false

MAX_TOKEN=8192
WORLD_ID=babe_univ
# Sites 등 별도 호스팅 UI가 로컬 GraphRAG 엔진에 연결할 때 허용할 origin 목록(쉼표 구분).
HOSTED_UI_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://graphrag-fiction-room.cyane123.chatgpt.site

# 동시 진행 LLM 호출 상한(후처리 버스트로 인한 429 방지). 여전히 자주 429면 1로 낮춰라.
LLM_MAX_CONCURRENCY=2
# 429(RESOURCE_EXHAUSTED) 발생 시 exponential backoff 재시도 최대 횟수.
LLM_MAX_RETRIES_429=4

GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
ANTHROPIC_CLAUDE_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_CLAUDE_SONNET_5_MODEL=claude-sonnet-5
ANTHROPIC_CLAUDE_OPUS_4_6_MODEL=claude-opus-4-6
ANTHROPIC_CLAUDE_OPUS_4_7_MODEL=claude-opus-4-7
ANTHROPIC_CLAUDE_OPUS_4_8_MODEL=claude-opus-4-8
ANTHROPIC_CLAUDE_OPUS_5_MODEL=claude-opus-5

DEEPSEEK_API_KEY=sk-*
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro
